@model SIMS.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - SIMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-navy: #1e3a5f;
            --accent-gold: #d4af37;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: linear-gradient(135deg, #0f2537 0%, #1e3a5f 50%, #2c5282 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            position: relative;
            overflow: hidden;
            padding: 20px;
        }
        
        /* Animated background circles - more subtle */
        body::before {
            content: '';
            position: absolute;
            top: -30%;
            right: -15%;
            width: 60%;
            height: 60%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
            animation: float 20s ease-in-out infinite;
        }
        
        body::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -15%;
            width: 60%;
            height: 60%;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.06) 0%, transparent 70%);
            animation: float 25s ease-in-out infinite reverse;
        }
        
        @@keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(15px, 15px) scale(1.05); }
        }
        
        .login-container {
            width: 100%;
            max-width: 380px;
            position: relative;
            z-index: 10;
        }
        
        .login-card {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(10px);
        }
        
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .login-header {
            background: linear-gradient(135deg, #1e3a5f 0%, #0f2537 100%);
            color: white;
            padding: 2.5rem 2rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .login-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d4af37' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: 0.3;
        }
        
        .login-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
        }
        
        .login-header .icon {
            width: 70px;
            height: 70px;
            background: rgba(212, 175, 55, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            border: 2.5px solid var(--accent-gold);
            position: relative;
            animation: pulse 2s ease-in-out infinite;
        }
        
        @@keyframes pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4); }
            50% { box-shadow: 0 0 0 12px rgba(212, 175, 55, 0); }
        }
        
        .login-header .icon i {
            font-size: 2.2rem;
            color: var(--accent-gold);
        }
        
        .login-header h2 {
            margin: 0;
            font-weight: 700;
            font-size: 1.8rem;
            letter-spacing: 1.5px;
            position: relative;
        }
        
        .login-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.9;
            font-size: 0.88rem;
            font-weight: 400;
            position: relative;
        }
        
        .login-body {
            padding: 2rem 2rem 2.5rem;
        }
        
        .form-group {
            margin-bottom: 1.4rem;
        }
        
        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.9rem;
        }
        
        .form-label i {
            color: var(--accent-gold);
            font-size: 1rem;
        }
        
        .form-control {
            border: 2px solid #e8ecef;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background-color: #f8f9fa;
        }
        
        .form-control:focus {
            border-color: var(--primary-navy);
            box-shadow: 0 0 0 0.2rem rgba(30, 58, 95, 0.1);
            background-color: white;
            transform: translateY(-1px);
        }
        
        .form-control::placeholder {
            color: #adb5bd;
            font-size: 0.9rem;
        }
        
        .form-check {
            margin: 1.2rem 0 1.5rem 0;
        }
        
        .form-check-input {
            width: 1.1rem;
            height: 1.1rem;
            margin-top: 0.15rem;
            border: 2px solid #dee2e6;
            cursor: pointer;
        }
        
        .form-check-input:checked {
            background-color: var(--primary-navy);
            border-color: var(--primary-navy);
        }
        
        .form-check-label {
            margin-left: 0.4rem;
            cursor: pointer;
            user-select: none;
            font-size: 0.9rem;
        }
        
        .btn-login {
            width: 100%;
            padding: 0.85rem;
            background: linear-gradient(135deg, #1e3a5f 0%, #0f2537 100%);
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }
        
        .btn-login::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(212, 175, 55, 0.3);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }
        
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(30, 58, 95, 0.35);
        }
        
        .btn-login:hover::before {
            width: 350px;
            height: 350px;
        }
        
        .btn-login:active {
            transform: translateY(0);
        }
        
        .btn-login span {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        
        .text-danger {
            font-size: 0.825rem;
            margin-top: 0.3rem;
            display: block;
        }
        
        .alert {
            border-radius: 10px;
            border: none;
            padding: 0.85rem 1rem;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            animation: slideDown 0.4s ease;
            font-size: 0.9rem;
        }
        
        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .alert-danger {
            background-color: #fee;
            color: #c33;
            border-left: 3px solid #c33;
        }
        
        .footer-text {
            text-align: center;
            margin-top: 1.5rem;
            color: #6c757d;
            font-size: 0.85rem;
        }
        
        .footer-text i {
            color: var(--accent-gold);
            margin-right: 0.3rem;
        }
        
        /* Responsive */
        @@media (max-width: 480px) {
            .login-container {
                max-width: 100%;
                padding: 0 10px;
            }
            
            .login-header {
                padding: 2rem 1.5rem 1.5rem;
            }
            
            .login-header .icon {
                width: 60px;
                height: 60px;
            }
            
            .login-header .icon i {
                font-size: 1.8rem;
            }
            
            .login-header h2 {
                font-size: 1.5rem;
            }
            
            .login-header p {
                font-size: 0.82rem;
            }
            
            .login-body {
                padding: 1.5rem 1.5rem 2rem;
            }
            
            .form-control {
                padding: 0.7rem 0.9rem;
                font-size: 0.9rem;
            }
        }
        
        @@media (max-height: 700px) {
            .login-header {
                padding: 2rem 2rem 1.5rem;
            }
            
            .login-header .icon {
                width: 60px;
                height: 60px;
                margin-bottom: 0.8rem;
            }
            
            .login-header .icon i {
                font-size: 1.8rem;
            }
            
            .login-body {
                padding: 1.5rem 2rem 2rem;
            }
            
            .form-group {
                margin-bottom: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="icon">
                    <i class="bi bi-book-fill"></i>
                </div>
                <h2>SIMS</h2>
                <p>Student Information Management System</p>
            </div>
            
            <div class="login-body">
                <form asp-action="Login" method="post">
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>@ViewBag.ErrorMessage</span>
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="form-group">
                        <label asp-for="Username" class="form-label">
                            <i class="bi bi-person-fill"></i>
                            Tên đăng nhập
                        </label>
                        <input asp-for="Username" class="form-control" placeholder="Nhập tên đăng nhập" autofocus>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Password" class="form-label">
                            <i class="bi bi-lock-fill"></i>
                            Mật khẩu
                        </label>
                        <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu">
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                        <label asp-for="RememberMe" class="form-check-label" for="rememberMe">
                            Ghi nhớ đăng nhập
                        </label>
                    </div>
                    
                    <button type="submit" class="btn-login">
                        <span>
                            <i class="bi bi-box-arrow-in-right"></i>
                            Đăng nhập
                        </span>
                    </button>
                </form>
                
                <div class="footer-text">
                    <i class="bi bi-shield-check"></i>
                    Đăng nhập an toàn & bảo mật
                </div>
            </div>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
