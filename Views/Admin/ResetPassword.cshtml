@model SIMS.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="page-header">
    <h2>
        <i class="bi bi-key"></i>
        Đổi mật khẩu tài khoản
    </h2>
    <p class="text-muted">Thiết lập mật khẩu mới cho tài khoản</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-person-circle me-2"></i>
                Thông tin tài khoản
            </div>
            <div class="card-body">
                <div class="mb-4 p-3 bg-light rounded">
                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted d-block">Tên đăng nhập</small>
                            <strong class="text-navy">@Model.Username</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Họ tên</small>
                            <strong>@Model.FullName</strong>
                        </div>
                    </div>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="FullName" />
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="NewPassword" class="form-label">
                            <i class="bi bi-lock text-navy me-1"></i>
                            Mật khẩu mới
                        </label>
                        <input asp-for="NewPassword" class="form-control" type="password" 
                               placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" autofocus />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="bi bi-lock-fill text-navy me-1"></i>
                            Xác nhận mật khẩu
                        </label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" 
                               placeholder="Nhập lại mật khẩu mới" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Lưu ý:</strong> Người dùng sẽ phải đăng nhập lại với mật khẩu mới này.
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="ManageAccounts" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Đổi mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="bi bi-lightbulb text-warning me-1"></i>
                    Gợi ý mật khẩu
                </h6>
                <ul class="mb-0 small">
                    <li>Mật khẩu nên có ít nhất 6 ký tự</li>
                    <li>Nên kết hợp chữ và số (ví dụ: student2024)</li>
                    <li>Tránh dùng mật khẩu quá đơn giản như 123456</li>
                    <li>Có thể dùng mã sinh viên/giảng viên kết hợp năm sinh</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
