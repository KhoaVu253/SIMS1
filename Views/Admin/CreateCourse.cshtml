@model SIMS.Models.ViewModels.CourseFormViewModel
@{
    ViewData["Title"] = "Thêm môn học";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-book"></i> Thêm môn học</h2>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="CreateCourse" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CourseCode" class="form-label"></label>
                        <input asp-for="CourseCode" class="form-control" />
                        <span asp-validation-for="CourseCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CourseName" class="form-label"></label>
                        <input asp-for="CourseName" class="form-control" />
                        <span asp-validation-for="CourseName" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Credits" class="form-label"></label>
                        <input asp-for="Credits" type="number" min="1" max="10" class="form-control" />
                        <span asp-validation-for="Credits" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Department" class="form-label">
                            <i class="bi bi-building me-1"></i>
                            Khoa
                        </label>
                        <select asp-for="Department" class="form-select">
                            <option value="">-- Chọn khoa --</option>
                            @foreach (var dept in ViewBag.Departments as string[])
                            {
                                <option value="@dept">@dept</option>
                            }
                        </select>
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FacultyId" class="form-label">
                            <i class="bi bi-person me-1"></i>
                            Giảng viên chính
                        </label>
                        <select asp-for="FacultyId" class="form-select" asp-items="ViewBag.Faculties">
                            <option value="">-- Chọn giảng viên chính --</option>
                        </select>
                        <span asp-validation-for="FacultyId" class="text-danger"></span>
                        <small class="text-muted">Tùy chọn. Có thể thêm nhiều giảng viên sau khi tạo môn học.</small>
                    </div>

                    <!-- ✅ NEW: Multiple Faculty Selection -->
                    <div class="col-md-12">
                        <label class="form-label">
                            <i class="bi bi-people me-1"></i>
                            Chọn nhiều giảng viên (Tùy chọn)
                        </label>
                        <select name="selectedFaculties" class="form-select" multiple size="5">
                            @foreach (var faculty in ViewBag.Faculties as SelectList)
                            {
                                <option value="@faculty.Value">@faculty.Text</option>
                            }
                        </select>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Giữ Ctrl (Windows) hoặc Cmd (Mac) để chọn nhiều giảng viên. 
                            Bạn cũng có thể thêm/quản lý giảng viên sau khi tạo môn học.
                        </small>
                    </div>

                    <div class="col-md-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="col-12">
                        <hr />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Lưu
                        </button>
                        <a asp-action="Courses" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Help Card -->
    <div class="card mt-3">
        <div class="card-header bg-info text-white">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Hướng dẫn</strong>
        </div>
        <div class="card-body">
            <h6>✨ Tính năng mới: Một môn học có thể có nhiều giảng viên!</h6>
            <ul class="mb-0">
                <li><strong>Giảng viên chính:</strong> Là giảng viên chính phụ trách môn học (tùy chọn)</li>
                <li><strong>Chọn nhiều giảng viên:</strong> Có thể chọn ngay khi tạo hoặc thêm sau</li>
                <li><strong>Quản lý sau:</strong> Sau khi tạo môn học, vào "Quản lý giảng viên" để phân công chi tiết (lớp, nhóm, vai trò)</li>
                <li><strong>Ví dụ:</strong> Môn "Lập trình căn bản" có thể có GV A dạy lớp A, GV B dạy lớp B</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Khi chọn Giảng viên chính, tự động chọn trong multiple select
            $('#FacultyId').on('change', function() {
                var selectedId = $(this).val();
                if (selectedId) {
                    $('select[name="selectedFaculties"] option[value="' + selectedId + '"]').prop('selected', true);
                }
            });
        });
    </script>
}
