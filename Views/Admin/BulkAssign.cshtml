@model SIMS.Models.ViewModels.BulkAssignViewModel
@{
    ViewData["Title"] = "Phân công hàng loạt";
}

<div class="page-header">
    <h2>
        <i class="bi bi-people-fill"></i>
        Phân công hàng loạt theo khoa/lớp
    </h2>
    <p class="text-muted">Phân công toàn bộ sinh viên của một khoa/lớp vào lớp học cụ thể</p>
</div>

<div class="row">
    <div class="col-md-10 offset-md-1">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Phân công hàng loạt
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Lưu ý:</strong> Chức năng này sẽ phân công tất cả sinh viên đang hoạt động
                    của khoa/lớp được chọn vào môn học. Hãy kiểm tra kỹ trước khi thực hiện!
                </div>

                <form asp-action="BulkAssign" method="post" id="bulkAssignForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <!-- Môn học -->
                        <div class="col-md-12">
                            <label asp-for="CourseId" class="form-label">
                                <i class="bi bi-book me-1"></i>
                                Môn học <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CourseId" class="form-select" asp-items="ViewBag.Courses" id="courseSelect">
                                <option value="">-- Chọn môn học --</option>
                            </select>
                            <span asp-validation-for="CourseId" class="text-danger"></span>
                        </div>

                        <!-- Học kỳ và Năm học -->
                        <div class="col-md-6">
                            <label asp-for="Semester" class="form-label">
                                <i class="bi bi-calendar3 me-1"></i>
                                Học kỳ <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Semester" class="form-select" id="semesterSelect">
                                @foreach (var sem in ViewBag.Semesters as string[])
                                {
                                    <option value="@sem">@sem</option>
                                }
                            </select>
                            <span asp-validation-for="Semester" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AcademicYear" class="form-label">
                                <i class="bi bi-calendar-range me-1"></i>
                                Năm học <span class="text-danger">*</span>
                            </label>
                            <input asp-for="AcademicYear" class="form-control" id="academicYearInput" placeholder="2024-2025" />
                            <span asp-validation-for="AcademicYear" class="text-danger"></span>
                        </div>

                        <!-- ✅ NEW: Lớp học (CourseSchedule) -->
                        <div class="col-md-12">
                            <label asp-for="ScheduleId" class="form-label">
                                <i class="bi bi-calendar-week me-1"></i>
                                Lớp học <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ScheduleId" class="form-select" id="scheduleSelect" disabled>
                                <option value="">-- Chọn môn học trước --</option>
                            </select>
                            <span asp-validation-for="ScheduleId" class="text-danger"></span>
                            <small class="text-muted">Chọn lớp học với giảng viên, thời gian, phòng học cụ thể</small>
                        </div>

                        <!-- Khoa -->
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">
                                <i class="bi bi-building me-1"></i>
                                Khoa <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Department" class="form-select">
                                <option value="">-- Chọn khoa --</option>
                                @foreach (var dept in ViewBag.Departments as string[])
                                {
                                    <option value="@dept">@dept</option>
                                }
                            </select>
                            <span asp-validation-for="Department" class="text-danger"></span>
                            <small class="text-muted">Bắt buộc: Chọn khoa để phân công</small>
                        </div>

                        <!-- Lớp sinh viên -->
                        <div class="col-md-6">
                            <label asp-for="ClassName" class="form-label">
                                <i class="bi bi-door-open me-1"></i>
                                Lớp (Không bắt buộc)
                            </label>
                            <input asp-for="ClassName" class="form-control" placeholder="Ví dụ: 21IT1" />
                            <span asp-validation-for="ClassName" class="text-danger"></span>
                            <small class="text-muted">Để trống = tất cả lớp của khoa</small>
                        </div>

                        <!-- Ghi chú -->
                        <div class="col-md-12">
                            <label asp-for="Notes" class="form-label">
                                <i class="bi bi-sticky me-1"></i>
                                Ghi chú
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="3" 
                                      placeholder="Ghi chú về đợt phân công này (không bắt buộc)"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="col-12">
                            <hr />
                            <button type="submit" class="btn btn-warning btn-lg" 
                                    onclick="return confirm('Bạn có chắc chắn muốn phân công hàng loạt? Hành động này sẽ ảnh hưởng đến nhiều sinh viên!');">
                                <i class="bi bi-lightning-fill"></i> Phân công hàng loạt
                            </button>
                            <a asp-action="ManageEnrollments" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-info text-white">
                <i class="bi bi-lightbulb me-2"></i>
                Ví dụ sử dụng
            </div>
            <div class="card-body">
                <h6>Ví dụ 1: Phân công toàn bộ khoa CNTT vào lớp IT101 - Lập trình C#</h6>
                <ul>
                    <li>Môn học: Lập trình C#</li>
                    <li>Học kỳ: HK1 - 2024-2025</li>
                    <li><strong>Lớp học: Thứ 2, Tiết 1-3, Phòng A102 (GV: Nguyễn Văn A)</strong></li>
                    <li>Khoa: Công Nghệ Thông Tin</li>
                    <li>Lớp: <em>(để trống)</em></li>
                    <li>→ Tất cả sinh viên khoa CNTT sẽ được phân công vào lớp này</li>
                </ul>

                <h6 class="mt-3">Ví dụ 2: Phân công lớp 21IT1 vào lớp học cụ thể</h6>
                <ul>
                    <li>Môn học: Cơ sở dữ liệu</li>
                    <li>Học kỳ: HK1 - 2024-2025</li>
                    <li><strong>Lớp học: Thứ 4, Tiết 7-9, Phòng B205 (GV: Trần Thị B)</strong></li>
                    <li>Khoa: Công Nghệ Thông Tin</li>
                    <li>Lớp: 21IT1</li>
                    <li>→ Chỉ sinh viên lớp 21IT1 được phân công vào lớp này</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            var courseSelect = $('#courseSelect');
            var semesterSelect = $('#semesterSelect');
            var academicYearInput = $('#academicYearInput');
            var scheduleSelect = $('#scheduleSelect');

            // Load schedules when course, semester, or academic year changes
            function loadSchedules() {
                var courseId = courseSelect.val();
                var semester = semesterSelect.val();
                var academicYear = academicYearInput.val();

                if (!courseId || !semester || !academicYear) {
                    scheduleSelect.html('<option value="">-- Vui lòng chọn môn học, học kỳ và năm học --</option>');
                    scheduleSelect.prop('disabled', true);
                    return;
                }

                scheduleSelect.html('<option value="">Đang tải...</option>');
                scheduleSelect.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("GetCourseSchedules", "Admin")',
                    type: 'GET',
                    data: {
                        courseId: courseId,
                        semester: semester,
                        academicYear: academicYear
                    },
                    success: function(schedules) {
                        scheduleSelect.empty();
                        
                        if (schedules.length === 0) {
                            scheduleSelect.append('<option value="">-- Chưa có lớp học nào --</option>');
                        } else {
                            scheduleSelect.append('<option value="">-- Chọn lớp học --</option>');
                            
                            $.each(schedules, function(index, schedule) {
                                var displayText = schedule.dayName + ', ' + 
                                                schedule.periodRange + ' (' + schedule.timeRange + '), ' +
                                                'Phòng ' + schedule.room + ' - GV: ' + schedule.facultyName;
                                
                                scheduleSelect.append(
                                    $('<option></option>')
                                        .val(schedule.scheduleId)
                                        .text(displayText)
                                );
                            });
                            
                            scheduleSelect.prop('disabled', false);
                        }
                    },
                    error: function() {
                        scheduleSelect.html('<option value="">Lỗi khi tải lịch học</option>');
                        alert('Không thể tải danh sách lịch học. Vui lòng thử lại!');
                    }
                });
            }

            // Event listeners
            courseSelect.change(loadSchedules);
            semesterSelect.change(loadSchedules);
            academicYearInput.blur(loadSchedules);

            // Load schedules on page load if values are set
            if (courseSelect.val() && semesterSelect.val() && academicYearInput.val()) {
                loadSchedules();
            }
        });
    </script>
}
