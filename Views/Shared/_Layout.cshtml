<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SIMS.styles.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Top Navbar - Fixed -->
        <nav class="navbar">
            <a class="navbar-brand" href="#">
                <i class="bi bi-book-fill"></i>
                <span>SIMS</span>
            </a>
            <div class="user-info">
                <div class="user-name">
                    <i class="bi bi-person-circle"></i>
                    <span>@User.Identity.Name</span>
                    <span class="badge">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </nav>

        <!-- Sidebar - Fixed với spacing từ navbar -->
        <nav class="sidebar">
            <div class="sidebar-sticky">
                <ul class="nav flex-column">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" 
                               asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Students" ? "active" : "")" 
                               asp-controller="Admin" asp-action="Students">
                                <i class="bi bi-people-fill"></i>
                                <span>Quản lý sinh viên</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Faculties" ? "active" : "")" 
                               asp-controller="Admin" asp-action="Faculties">
                                <i class="bi bi-person-badge-fill"></i>
                                <span>Quản lý giảng viên</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Courses" ? "active" : "")" 
                               asp-controller="Admin" asp-action="Courses">
                                <i class="bi bi-book-fill"></i>
                                <span>Quản lý môn học</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageSchedules" || ViewContext.RouteData.Values["action"]?.ToString() == "CreateSchedule" || ViewContext.RouteData.Values["action"]?.ToString() == "EditSchedule" ? "active" : "")" 
                               asp-controller="Admin" asp-action="ManageSchedules">
                                <i class="bi bi-calendar-week"></i>
                                <span>Quản lý lịch học</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageEnrollments" || ViewContext.RouteData.Values["action"]?.ToString() == "AssignStudents" || ViewContext.RouteData.Values["action"]?.ToString() == "BulkAssign" ? "active" : "")" 
                               asp-controller="Admin" asp-action="ManageEnrollments">
                                <i class="bi bi-calendar-check"></i>
                                <span>Phân công lớp học</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ManageAccounts" || ViewContext.RouteData.Values["action"]?.ToString() == "ResetPassword" ? "active" : "")" 
                               asp-controller="Admin" asp-action="ManageAccounts">
                                <i class="bi bi-person-lock"></i>
                                <span>Quản lý tài khoản</span>
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Student"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" 
                               asp-controller="Student" asp-action="Dashboard">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "WeeklySchedule" ? "active" : "")" 
                               asp-controller="Student" asp-action="WeeklySchedule">
                                <i class="bi bi-calendar-week"></i>
                                <span>Lịch học theo tuần</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MySchedule" ? "active" : "")" 
                               asp-controller="Student" asp-action="MySchedule">
                                <i class="bi bi-list-check"></i>
                                <span>Danh sách môn học</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyGrades" ? "active" : "")" 
                               asp-controller="Student" asp-action="MyGrades">
                                <i class="bi bi-trophy-fill"></i>
                                <span>Xem điểm</span>
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Faculty"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" 
                               asp-controller="Faculty" asp-action="Dashboard">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MySchedule" ? "active" : "")" 
                               asp-controller="Faculty" asp-action="MySchedule">
                                <i class="bi bi-calendar-week"></i>
                                <span>Lịch dạy của tôi</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyCourses" ? "active" : "")" 
                               asp-controller="Faculty" asp-action="MyCourses">
                                <i class="bi bi-journals"></i>
                                <span>Môn học của tôi</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <!-- Main content - Với spacing đúng -->
        <main class="main-content fade-in">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
