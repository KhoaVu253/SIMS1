@model IEnumerable<SIMS.Models.ViewModels.StudentScheduleViewModel>
@{
    ViewData["Title"] = "Lịch học của tôi";
}

<div class="page-header">
    <h2>
        <i class="bi bi-calendar-week"></i>
        Lịch học của tôi
    </h2>
    <p class="text-muted">Xem các môn học đã được phân công</p>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">
                    <i class="bi bi-calendar3 me-1"></i>
                    Học kỳ
                </label>
                <select name="semester" class="form-select" onchange="this.form.submit()">
                    @foreach (var sem in ViewBag.Semesters as string[])
                    {
                        <option value="@sem" selected="@(ViewBag.Semester == sem)">@sem</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">
                    <i class="bi bi-calendar-range me-1"></i>
                    Năm học
                </label>
                <input type="text" name="academicYear" class="form-control" 
                       value="@ViewBag.AcademicYear" placeholder="2024-2025">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Xem lịch
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Chưa có môn học nào</h4>
            <p class="text-muted">
                Bạn chưa được phân công vào môn học nào trong học kỳ này.<br/>
                Vui lòng liên hệ phòng đào tạo để biết thêm chi tiết.
            </p>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="stat-card stat-card-navy">
                <i class="bi bi-journal-check icon"></i>
                <h6>Tổng số môn</h6>
                <h2>@Model.Count()</h2>
                <small class="text-white d-block mt-2">Học kỳ @ViewBag.Semester</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-card-blue">
                <i class="bi bi-award-fill icon"></i>
                <h6>Tổng tín chỉ</h6>
                <h2>@Model.Sum(m => m.Credits)</h2>
                <small class="text-white d-block mt-2">Đã đăng ký</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-card-green">
                <i class="bi bi-check-circle icon"></i>
                <h6>Đã hoàn thành</h6>
                <h2>@Model.Count(m => m.Status == "Completed")</h2>
                <small class="text-white d-block mt-2">Môn học</small>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-list-ul me-2"></i>
            Danh sách môn học (@ViewBag.Semester - @ViewBag.AcademicYear)
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th><i class="bi bi-book me-1"></i> Mã môn</th>
                            <th>Tên môn học</th>
                            <th><i class="bi bi-award me-1"></i> Tín chỉ</th>
                            <th><i class="bi bi-person me-1"></i> Giảng viên</th>
                            <th>Trạng thái</th>
                            <th>Điểm giữa kỳ</th>
                            <th>Điểm cuối kỳ</th>
                            <th>Điểm TB</th>
                            <th>Xếp loại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td><strong class="text-navy">@item.CourseCode</strong></td>
                                    <td>@item.CourseName</td>
                                    <td><span class="badge bg-info">@item.Credits</span></td>
                                    <td>@item.FacultyName</td>
                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge bg-success">Đang học</span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">Hoàn thành</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Rút môn</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.MidtermScore.HasValue)
                                        {
                                            <span class="text-primary">@item.MidtermScore.Value.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.FinalScore.HasValue)
                                        {
                                            <span class="text-primary">@item.FinalScore.Value.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.AverageScore.HasValue)
                                        {
                                            <strong class="text-success">@item.AverageScore.Value.ToString("F2")</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.LetterGrade))
                                        {
                                            var badgeClass = item.LetterGrade.StartsWith("A") ? "bg-success" :
                                                           item.LetterGrade.StartsWith("B") ? "bg-primary" :
                                                           item.LetterGrade.StartsWith("C") ? "bg-info" :
                                                           item.LetterGrade.StartsWith("D") ? "bg-warning" : "bg-danger";
                                            <span class="badge @badgeClass">@item.LetterGrade</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header bg-info text-white">
            <i class="bi bi-info-circle me-2"></i>
            Thông tin
        </div>
        <div class="card-body">
            <ul class="mb-0">
                <li><strong>Đang học:</strong> Môn học đang diễn ra trong học kỳ</li>
                <li><strong>Hoàn thành:</strong> Đã hoàn thành môn học và có điểm</li>
                <li><strong>Rút môn:</strong> Đã rút khỏi môn học</li>
                <li class="mt-2 text-muted">
                    <i class="bi bi-lightbulb"></i> 
                    Nếu có thắc mắc về lịch học, vui lòng liên hệ phòng đào tạo
                </li>
            </ul>
        </div>
    </div>
}
